# Example .env file for stace
# Copy this to `.env` and fill in real values before running.

# IMAP/Email settings (used by Imbox to read verification emails)
EMAIL_HOST=imap.example.com
EMAIL_USER=your_imap_user@example.com
EMAIL_PASSWORD=supersecretpassword

# Alias/email format used by generate_random_email() — must include [PLACEHOLDER]
# Example: test+[PLACEHOLDER]@example.com -> test+abc123@example.com
ALIAS_FORMAT=test+[PLACEHOLDER]@example.com

# Optional: tuning
#PASSWORD_LENGTH=16

# Optional: posting to kuroi instance (if set, stace will post generated accounts to this instance)
#KUROI_BASE_URL=https://kuroi.example.com
#KUROI_API_KEY=your_kuroi_api_key